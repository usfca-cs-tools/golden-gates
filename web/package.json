{
  "name": "golden-gates-frontend",
  "version": "0.0.1",
  "description": "Golden Gates digital logic circuit designer and simulator",
  "author": "USF CS Tools <phpeterson@usfca.edu>",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:check": "vue-tsc && vite build",
    "preview": "vite preview",
    "build:info": "node scripts/gen-build-info.cjs",
    "electron:dev": "node scripts/gen-build-info.cjs && vite build && electron .",
    "electron:build": "node scripts/gen-build-info.cjs && vite build && electron-builder",
    "icon": "node scripts/generate-icon.mjs",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --ext .js,.vue,.ts",
    "lint:fix": "eslint . --ext .js,.vue,.ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "primeicons": "^6.0.1",
    "primevue": "^3.40.0",
    "pyodide": "^0.27.6",
    "vue": "^3.3.4",
    "vue-i18n": "^9.14.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/node": "^24.1.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.4.6",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.2",
    "eslint": "^9.31.0",
    "eslint-plugin-vue": "^10.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "sharp": "^0.35.1",
    "typescript": "^5.8.3",
    "vite": "^7.0.4",
    "vite-plugin-static-copy": "^3.1.1",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.4"
  },
  "build": {
    "productName": "Golden Gates",
    "appId": "com.goldengates.app",
    "directories": {
      "output": "release"
    },
    "afterPack": "./scripts/afterpack-sign.cjs",
    "fileAssociations": [
      {
        "ext": "ggc",
        "name": "Golden Gates Circuit",
        "description": "Golden Gates Circuit file",
        "role": "Editor",
        "icon": "assets/icon"
      }
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "artifactName": "GoldenGates-${version}-macos-${arch}.${ext}",
      "target": [
        { "target": "dmg", "arch": "arm64" },
        { "target": "zip", "arch": "arm64" }
      ]
    },
    "win": {
      "icon": "assets/icon.png",
      "artifactName": "GoldenGates-${version}-windows-${arch}.${ext}",
      "target": [
        { "target": "nsis", "arch": "x64" }
      ]
    },
    "files": [
      "dist/**/*",
      "main.cjs",
      "preload.cjs",
      "build-info.json",
      "assets/**/*"
    ]
  }
}
